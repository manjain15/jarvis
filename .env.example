# Copy this file to .env and fill in real values. .env is gitignored.
YOUR_EMAIL=your-email@example.com
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-proj-...
HEVY_API_KEY=...
NTFY_CHANNEL=jarvis-yourname-xxxx
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=0
# UNSW timetable subscribed feed (Mac Calendar → right-click calendar → Get Info → copy URL)
TIMETABLE_ICS_URL=
# Laptop sync scripts only (deploy/sync-data-down.sh, deploy/sync-finance-up.sh).
JARVIS_VPS_USER=
JARVIS_VPS_HOST=
# Bearer token for the agent HTTP API (agent_api.py). Long random string.
JARVIS_API_TOKEN=
# Preferred: one token per bot, each limited to its own routes and named in the
# audit log. Format name:token, comma separated; names: career, study, money, admin.
# Tokens must be 32+ characters. JARVIS_API_TOKEN above still works (full access).
JARVIS_API_TOKENS=
# Daily caps for the routes that cost money (0 = unlimited).
JARVIS_API_ASK_DAILY=30
JARVIS_API_MEMORY_DAILY=100
