[Unit]
Description=Jarvis morning brief
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jarvis
Group=jarvis
WorkingDirectory=/home/jarvis/jarvis
ExecStart=/home/jarvis/jarvis/venv/bin/python /home/jarvis/jarvis/morning_brief.py
Environment=PYTHONUNBUFFERED=1
TimeoutStartSec=600
