[Unit]
Description=Jarvis agent HTTP API (localhost bearer-token endpoint)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jarvis
Group=jarvis
WorkingDirectory=/home/jarvis/jarvis
ExecStart=/home/jarvis/jarvis/venv/bin/python /home/jarvis/jarvis/agent_api.py --serve
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
