[Unit]
Description=Jarvis Gmail monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jarvis
Group=jarvis
WorkingDirectory=/home/jarvis/jarvis
ExecStart=/home/jarvis/jarvis/venv/bin/python /home/jarvis/jarvis/gmail_monitor.py
Environment=PYTHONUNBUFFERED=1
TimeoutStartSec=300
